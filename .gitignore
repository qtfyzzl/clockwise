# Ignore the "build" directory created by esp-idf
build

# Ignore the user-customized project configuration file.
# (https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/kconfig.html)
sdkconfig*
# Unignore the default project configuration file.
!sdkconfig.defaults

# Ignore IDE configs
.vscode

dependencies.lock

# ---- 本地开发产物（本项目定制部分）----
# 构建日志：每次编译都生成，无版本价值
*.log

# 烧录产物：每个合并镜像 1.5MB 以上，可由 dist/flash.ps1 重新生成
dist/*.bin
dist/*.elf
# 但 firmware.bin 是 flash.ps1 烧录的必需文件（缺失会报错退出），单独放行
!dist/firmware.bin
!dist/partitions.bin
!dist/bootloader.bin
!dist/boot_app0.bin

# 编辑器打包输出与压缩包（11MB PyInstaller 产物，源码在 editor/ 下）
editor/dist/
editor.zip

# Python 缓存
__pycache__/
*.pyc

# 临时安装的 Python 依赖（验证工具用，不属于仓库）
dist/_pylibs/

# 分发用压缩包（可由源码重新打包，18MB 不入库）
clockwise-*.zip
*.bak
.git.bak/

# 调试临时文件与系统导出（含 WiFi 配置导出，绝不上传）
dist/_*.txt
dist/_*.xml
dist/_*.log
*_wifi_*.xml
